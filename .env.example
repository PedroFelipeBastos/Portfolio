# Copie para .env.local e preencha. O .env.local NÃO vai para o GitHub (.gitignore).
# Na Vercel, cadastre as mesmas variáveis em Settings → Environment Variables.

# ---------------------------------------------------------------------------
# EmailJS (https://dashboard.emailjs.com/admin) — formulário de contato
# Com o prefixo VITE_ elas vão para o navegador: o EmailJS foi feito para isso
# (são IDs públicos). O template usa {{name}}, {{email}}, {{message}} e {{time}}.
# ---------------------------------------------------------------------------
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# ---------------------------------------------------------------------------
# WakaTime — SEM o prefixo VITE_: a chave é secreta e é lida só no servidor
# (vite.config.js no npm run dev e api/wakatime.js na Vercel).
# https://wakatime.com/settings/api-key
# ---------------------------------------------------------------------------
WAKATIME_API_KEY=

# ---------------------------------------------------------------------------
# GitHub — opcional. Sem token a API pública libera 60 chamadas/hora por IP;
# com token, 5.000. Token fine-grained só de leitura:
# https://github.com/settings/personal-access-tokens
# ---------------------------------------------------------------------------
GITHUB_TOKEN=
